{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FBForge Inspect",
  "version": "0.2.0",
  "identifier": "de.fbforge.inspect",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist",
    "beforeBundleCommand": "node scripts/installer-guard.mjs && node desktop/installer/nsis/toolchain.mjs prepare"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FBForge Inspect",
        "width": 1180,
        "height": 800,
        "minWidth": 700,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'self'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Zustellpunkte, Routing und PVOG-Adressierung prüfen",
    "resources": {
      "resources/engine/": "engine/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ],
        "displayLanguageSelector": false,
        "template": "installer/installer.nsi",
        "installerHooks": "installer/guard.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "useLocalToolsDir": true
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
